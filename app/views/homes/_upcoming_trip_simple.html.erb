<!-- upcoming trip section -->
<section class="upcoming-trips">
  <div class="container">
    <!-- title -->
    <div class="common-heading-wrapper d-flex align-items-center justify-content-between">
      <div class="left-title" data-aos="fade-right" data-aos-duration="1000" data-aos-delay="50">
        <h3>Upcoming Trip</h3>
        <h4>Upcoming Trip</h4>
        <span class="line-x"></span>
      </div>
      <a href="/upcoming_trips" class="see-all-btn" data-aos="fade-left" data-aos-duration="1000" data-aos-delay="50">See All<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M16.1716 10.9999L10.8076 5.63589L12.2218 4.22168L20 11.9999L12.2218 19.778L10.8076 18.3638L16.1716 12.9999H4V10.9999H16.1716Z"></path></svg></a>
    </div>
    <div class="video-overlay-wrapper">
      <span class="overlay-bg"></span>
      <video class="my-video" autoplay muted loop>
        <source src="<%= asset_path 'hero_video.mp4' %>" type="video/mp4"/>
      </video>
      <div class="title-wrapper">
        <h3 data-aos="fade-up" data-aos-duration="1000" data-aos-delay="100" id="animatedText">Let's Explore India</h3>
        <p data-aos="fade-up" data-aos-duration="1000" data-aos-delay="200">A Journey Through Time, Colour And Culture</p>
      </div>
    </div>
  </div>
</section>
<div class="container">
  <div class="row">
    <% @upcoming_trips&.each do |trip| %>
      <div class="col-md-3 mb-4">
        <!-- Image -->
        <%= image_tag (trip.poster.presence || asset_path('trips photos/rann-kutch-fes.png')), alt: trip.title, class: "trip-poster-img" %>

        <!-- Trip Info Card -->
        <div class="trip-card text-white bg-dark rounded">
          <div class="details p-3">
            <!-- Title -->
            <h3 class="trip-title mb-3"><%= trip.title %></h3>

            <!-- Row: Time + Button -->
            <div class="trip-meta d-flex align-items-center justify-content-between">
              <div class="d-flex align-items-center">
                <img src="<%= asset_path 'Time Circle.svg' %>" alt="time" class="me-2" style="width: 20px;" />
                <h4 class="mb-0"><%= trip.number_of_days %> Days</h4>
              </div>
              <a href="<%= upcoming_trip_itineraries_path(trip) %>" class="btn btn-light btn-sm d-flex align-items-center">
                Itinerary
                <img src="<%= asset_path 'Arrow-Right .svg' %>" alt="right-arrow" class="ms-1" style="width: 16px;" />
              </a>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<style>
  .trip-poster-img {
    height: 300px;
    width: 100%;
    object-fit: cover;
    border-radius: 0.5rem;
  }

  .trip-card {
    background: linear-gradient(rgb(64, 224, 208), rgb(42, 159, 157));
    border-radius: 0.5rem;
    color: #fff;
  }

  .trip-title {
    font-size: 1.25rem;
    font-weight: bold;
  }

  .trip-meta h4 {
    font-size: 0.95rem;
  }

  .btn-sm {
    padding: 0.3rem 0.75rem;
    font-size: 0.85rem;
  }

</style>